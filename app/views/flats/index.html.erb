<div class="container">
  <div class='mt-5 d-flex justify-content-between align-items-center'>
    <h1>All Flats</h1>
    <%= link_to "Add New Flat", new_flat_path, class: "btn btn-primary" %>
  </div>


  <div class="row">
    <% @flats.each do |flat| %>
      <%= link_to flat_path(flat), class: "col-4 g-5 text-decoration-none" do %>
        <div class="card">
          <img src="https://images.unsplash.com/photo-1451153378752-16ef2b36ad05?q=80&w=2334&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="card-img-top" alt="...">
          <div class="card-body">
            <h5 class="card-title"><%= flat.name %></h5>
            <p class="card-text"><%= flat.address %></p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
